:: Deadwood Reblooms Operations Widgets [widget]

<!-- 只汇总现有账目。读日志不收款、不支付工资，也不推进任何经营日期。 -->
<<widget 'deadwood-finance-operations'>>
  <<set _operations_finance to maplebirch.get('Finance')>>
  <<set _operations_factories to _operations_finance.industry.owned>>
  <<set _operations_company to _operations_finance.company>>
  <<set _operations_robin to maplebirch.get('Robin')>>
  <<set _operations_orchard to maplebirch.get('Orchard')>>
  <<if !_operations_company.state.name and !_operations_factories.length and !_operations_robin?.shop.investment.contract.share and !_operations_orchard?.state.worker.hired and !_operations_orchard?.staff.employed>><<exit>><</if>>
  <<set _operations_staff_debt to _operations_company.staff.arrears>>
  <<set _operations_arrears to _operations_company.state.rent_arrears + _operations_staff_debt + _operations_company.suite.state.arrears + _operations_factories.reduce((sum, factory) => sum + factory.wage_arrears + factory.overhead_arrears, 0)>>
  <<set _operations_receivables to _operations_factories.reduce((sum, factory) => sum + factory.invoices.reduce((total, invoice) => total + invoice.order.total, 0) + factory.laboratory.invoices.reduce((total, invoice) => total + invoice.total, 0), 0)>>
  <<if ['disputed', 'waiting'].includes(_operations_company.state.contract?.stage)>>
    <<set _operations_receivables += _operations_company.state.contract.due>>
  <</if>>
  <details id='deadwood-finance-operations'>
    <summary><<lanSwitch 'Business accounts and outstanding decisions' '经营账目与待办'>></summary>
    <div class='dr-finance-summary'>
      <span><<lanSwitch 'Factory working funds' '工厂周转金'>></span><span><<deadwood-reblooms-finance-money `_operations_factories.reduce((sum, factory) => sum + factory.cash, 0)`>></span>
      <span><<lanSwitch 'Outstanding customer payments' '待收客户货款'>></span><span><<deadwood-reblooms-finance-money _operations_receivables>></span>
      <span><<lanSwitch 'Unpaid business wages and bills' '经营欠薪与未付费用'>></span><span><<deadwood-reblooms-finance-money _operations_arrears `_operations_arrears > 0 ? 'red' : 'gold'`>></span>
      <<if _operations_factories.length>>
        <span><<lanSwitch "Seven days' factory payroll and bills" '工厂七天工资与日常费用'>></span><span><<deadwood-reblooms-finance-money `_operations_factories.reduce((sum, factory) => sum + _operations_finance.industry.dailyCosts[factory.site] * 7, 0)`>></span>
      <</if>>
      <<if _operations_company.state.office>>
        <span><<lanSwitch 'Weekly office rent and employed staff' '办公室每周租金与在职职员工资'>></span><span><<deadwood-reblooms-finance-money `_operations_company.terms.weeklyRent + _operations_company.staff.roles.reduce((sum, role) => sum + (_operations_company.staff.state[role].employed ? _operations_company.terms.staff[role].weeklyWage : 0), 0)`>></span>
      <</if>>
    </div>
    <ul class='journal'>
      <li>
        <<language>>
          <<option 'EN'>>
            Factory funds stay at their own sites. Unpaid invoices and money retained in Avery's company are not available bank funds. The figures above exclude new materials, repairs and exceptional losses.
          <<option 'CN'>>
            各厂周转金分别留在厂里。未收货款与艾弗里公司留存的钱，不能当作银行可用余额。上列日常费用不含新购原料、维修及意外损失。
        <</language>>
      </li>
      <<for _operations_factory range _operations_factories>>
        <<set _operations_automatic to _operations_factory.automatic or _operations_factory.laboratory.automatic>>
        <<if _operations_factory.wage_arrears gt 0 or _operations_factory.overhead_arrears gt 0 or _operations_factory.issue or _operations_factory.morale lt 20>>
          <li>
            <span class='gold'><<= maplebirch.t(_operations_finance.industry.terms.sites[_operations_factory.site].name)>></span><<lanSwitch ': ' '：'>>
            <<if _operations_factory.wage_arrears gt 0 or _operations_factory.overhead_arrears gt 0>>
              <span class='red'><<lanSwitch 'Production is suspended until unpaid wages and bills are cleared at the yard.' '须到厂里结清欠薪与费用，生产才会恢复。'>></span>
            <<elseif _operations_factory.issue and _operations_factory.issue.type isnot 'haul'>>
              <span class='red'><<lanSwitch 'An unresolved incident has stopped production. The manager is waiting for your decision.' '事故或上门纠纷尚未处理，生产已停。经理在等你决定。'>></span>
            <<elseif _operations_factory.morale lt 20>>
              <span class='red'><<lanSwitch 'The exhausted crew have stopped work. Continuing rush shifts will not bring them back.' '疲惫的工人已经停工，继续催工不会让他们回来。'>></span>
            <<else>>
              <<lanSwitch 'A transport offer is waiting at the yard; production can continue.' '院子里有个运输提议等你答复，生产仍可继续。'>>
            <</if>>
          </li>
        <</if>>
        <<if _operations_automatic and !_operations_factory.manager>>
          <li class='red'><<= maplebirch.t(_operations_finance.industry.terms.sites[_operations_factory.site].name)>><<lanSwitch ': automatic production needs a shift manager.' '：自动生产需要值班经理。'>></li>
        <<elseif _operations_automatic and _operations_factory.workers lt 2>>
          <li class='red'><<= maplebirch.t(_operations_finance.industry.terms.sites[_operations_factory.site].name)>><<lanSwitch ': fewer than two workers remain; production is suspended.' '：工人不足两名，生产暂停。'>></li>
        <<elseif _operations_factory.laboratory.automatic and !_operations_factory.laboratory.technician>>
          <li class='red'><<= maplebirch.t(_operations_finance.industry.terms.sites[_operations_factory.site].name)>><<lanSwitch ': processing is waiting for a technician.' '：加工间正在等待技术员。'>></li>
        <<elseif _operations_automatic and !_operations_factory.order and !_operations_factory.laboratory.job and _operations_factory.cash lt _operations_factory.reserve + _operations_finance.industry.dailyCosts[_operations_factory.site] * 3>>
          <li class='blue'><<= maplebirch.t(_operations_finance.industry.terms.sites[_operations_factory.site].name)>><<lanSwitch ': the manager is holding the reserve and three days of expenses; new materials cannot be bought yet.' '：经理正保留周转底金与三天费用，暂时无法采购新原料。'>></li>
        <</if>>
      <</for>>
      <<if _operations_company.state.office and (_operations_company.state.rent_arrears gt 0 or $Finance.collection.amount gt 0)>>
        <li class='red'><<lanSwitch 'Office business and staff services are suspended. Settle the office rent or recovery notice.' '办公室业务与职员服务已暂停。须处理欠租或追偿通知。'>></li>
      <</if>>
      <<if _operations_staff_debt gt 0>>
        <li class='red'><<lanSwitch 'Office staff will not work without cleared wages. Existing arrears remain payable after resignation.' '办公室职员欠薪时不工作。即使已经辞职，旧欠薪仍需结清。'>></li>
      <</if>>
      <<if _operations_robin?.shop.investment.contract.share gt 0>>
        <li>
          <<lanSwitch "Your private stake in Robin's drinks shop: " '你在罗宾饮品店的私人份额：'>><span class='teal'><<= _operations_robin.shop.investment.contract.share>>%</span><<lanSwitch '.' '。'>>
          <<lanSwitch "Dividends, orchard supplies and factory purchases draw on Robin's real funds while protecting the next rent payment." '分红、果园供货与工厂采购均从罗宾实际持有的钱中支付，并保留下次房租。'>>
          <<if _operations_robin.shop.investment.contract.exit_day gte 0>>
            <span class='blue'><<lanSwitch ' A buyback is pending; it waits if the shop cannot afford it.' ' 回购申请待处理；店铺付不起时会延后。'>></span>
          <</if>>
        </li>
      <</if>>
      <<if _operations_orchard?.state.worker.hired>>
        <li>
          <<lanSwitch 'Orchard worker wages are prepaid through ' '果园雇工薪资已预付至 '>><<= getFormattedDate(new DateTime(_operations_orchard.state.worker.paid_until))>><<lanSwitch '.' '。'>>
          <<if _operations_orchard.state.worker.paid_until lte Time.date.timeStamp>>
            <span class='red'><<lanSwitch ' Work is suspended until wages are renewed.' ' 须续薪后才能恢复工作。'>></span>
          <</if>>
        </li>
      <</if>>
      <<if _operations_orchard?.staff.employed>>
        <li>
          <<lanSwitch 'The trapper is paid through ' '捕捉雇工薪资已预付至 '>><<deadwood-reblooms-finance-date _operations_orchard.staff.state.paid_until>><<lanSwitch '.' '。'>>
          <<if _operations_orchard.staff.state.status is 'missing'>>
            <span class='red'><<lanSwitch ' The worker is missing. Arrange a search at the farm.' ' 雇工失踪了，须到农场安排搜寻。'>></span>
          <<elseif _operations_orchard.staff.state.status is 'injured'>>
            <span class='red'><<lanSwitch ' The worker is recovering; no trapping work is being done.' ' 雇工正在养伤，捕捉工作暂停。'>></span>
          <<elseif _operations_orchard.staff.state.paid_until lte Math.floor(Time.days)>>
            <span class='red'><<lanSwitch ' Wages must be renewed before the next outing.' ' 再次外出前须续付工资。'>></span>
          <</if>>
        </li>
      <</if>>
    </ul>
  </details>
  <<if _operations_arrears gt 0 or _operations_factories.some(factory => factory.issue or factory.morale lt 20) or ['missing', 'injured'].includes(_operations_orchard?.staff.state.status)>>
    <<done>><<run document.getElementById('deadwood-finance-operations').open = true>><</done>>
  <</if>>
<</widget>>
