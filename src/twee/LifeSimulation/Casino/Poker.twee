:: Deadwood Reblooms Life Simulation Poker View Widgets [widget]
<<widget 'deadwood-poker-name'>>
  <<set $_names to {player: ['You', '你'], Wren: ['Wren', '伦恩'], Avery: ['Avery', '艾弗里'], Bailey: ['Bailey', '贝利'], Leighton: ['Leighton', '礼顿'], Quinn: ['Quinn', '奎因'], regular: ['The regular', '熟客'], visitor: ['The visitor', '来客'], guest: ['The other player', '另一位客人']}>>
  <<if $_names[_args[0]]>><<lanSwitch `$_names[_args[0]][0]` `$_names[_args[0]][1]`>>
  <<else>><<lanSwitch 'Guest ' '客人 '>><<= Number(_args[0].split('_')[1]) + 1>><</if>>
<</widget>>

<<widget 'deadwood-poker-stakes'>>
  <<set $_casino to maplebirch.get('LifeSimulation').casino>>
  <<set $_stakes to _args[0] is 'holdem' ? $_casino.holdem.buyIns : _args[0] is 'three' ? $_casino.threeCard.antes : $_casino.blackjack.bets>>
  <<for $_index, $_stake range $_stakes>>
    <<if $_index gt 0>>
      /
    <</if>>
    <span class='gold'>£<<print Number(($_stake / 100).toFixed(2))>></span>
    <<if _args[0] is 'holdem'>>
      (<<printmoney `$_stake / $_casino.holdem.options.bigBlindDivisor / 2`>> / <<printmoney `$_stake / $_casino.holdem.options.bigBlindDivisor`>>)
    <</if>>
  <</for>>
<</widget>>

<<widget 'deadwood-poker-log'>>
  <<set $_pokerLogGame to _args[0] is 'pub' ? maplebirch.get('StreetLife').smugglerPub.cards.holdem : _args[0] is 'private' ? maplebirch.get('Finance').company.avery.cards : _args[0] is 'watch' ? maplebirch.get('LifeSimulation').casino.watch : _args[0] is 'holdem' ? maplebirch.get('LifeSimulation').casino.holdem : maplebirch.get('LifeSimulation').casino.threeCard>>
  <div class='poker-log' role='log'>
    <<for $_pokerEntry range $_pokerLogGame.state.log.slice(-6)>>
      <p><<deadwood-poker-name `$_pokerLogGame.state.seats[$_pokerEntry.seat].name`>>
        <<switch $_pokerEntry.action>>
          <<case 'fold'>><<lanSwitch 'folds' '弃牌'>>
          <<case 'check'>><<lanSwitch 'checks' '过牌'>>
          <<case 'call'>><<lanSwitch 'calls' '跟注'>>
          <<case 'raise'>>
            <<if _args[0] isnot 'three'>><<lanSwitch 'raises to' '加注至'>>
            <<else>><<lanSwitch 'raises, putting in' '加注，投入'>><</if>>
          <<case 'allin'>><<lanSwitch 'goes all-in at' '全下至'>>
          <<case 'compare'>><<lanSwitch 'compares' '比牌'>>
          <<default>><<print $_pokerEntry.action>>
        <</switch>>
        <<if !['fold', 'check'].includes($_pokerEntry.action)>>
          <<printmoney $_pokerEntry.amount>>
        <</if>>
      </p>
    <</for>>
  </div>
<</widget>>

<<widget 'deadwood-poker-holdem-view'>>
  <<set $_holdemHandNames to [['High card', '高牌'], ['One pair', '一对'], ['Two pair', '两对'], ['Three of a kind', '三条'], ['Straight', '顺子'], ['Flush', '同花'], ['Full house', '葫芦'], ['Four of a kind', '四条'], ['Straight flush', '同花顺']]>>
  <<set $_holdemPrivate to _args[0] is 'private'>>
  <<set $_holdemPub to _args[0] is 'pub'>>
  <<set $_holdem to $_holdemPub ? maplebirch.get('StreetLife').smugglerPub.cards.holdem : $_holdemPrivate ? maplebirch.get('Finance').company.avery.cards : _args[0] is 'watch' ? maplebirch.get('LifeSimulation').casino.watch : maplebirch.get('LifeSimulation').casino.holdem>><<set $_holdemState to $_holdem.state>>
  <<set $_holdemWatching to $_holdem.watching>>
  <p><<lanSwitch 'Seats: ' '本桌人数：'>><<= $_holdem.tableSize>><<if $_holdemPrivate>> · <<lanSwitch 'Hands: ' '已打局数：'>><<= $_holdem.session.hands>>/1<</if>></p>
  <div class='poker-table'>
    <<if !$_holdemState.joined>>
      <<if $_holdemPrivate>>
        <p><<lanSwitch 'Choose your buy-in. The remaining money is returned when you leave; committed bets remain in the pot. No credit at this table.' '选择买入金额。离席时退回余款，已下注的钱留在底池。这张桌不赊账。'>></p>
      <<else>>
        <<if $_holdemPub>>
          <p><<lanSwitch 'Count out cash from your wallet. Money left on the table is returned when you leave; committed bets stay in the pot. No credit or table fee.' '从钱包取出现金上桌。离桌时收回余款，已经下注的钱留在底池。不赊账，也不抽水。'>></p>
        <<else>><p><<language>>
        <<option 'EN'>>
          Choose how many of your casino chips to bring to the table. Chips left when you leave return to your casino balance.
        <<option 'CN'>>
          选择带上牌桌的筹码数额。离桌时，剩余筹码会退回给你。
        <</language>></p><</if>>
        <div class='poker-controls'>
          <<for $_holdemSize range $_holdem.options.seats>>
            <button type='button' data-action='seats' @data-amount="$_holdemSize" @aria-pressed="String($_holdemSize === $_holdem.tableSize)"><<= $_holdemSize>><<lanSwitch ' seats' ' 人桌'>></button>
          <</for>>
        </div>
      <</if>>
    <<else>>
      <p class='poker-summary'>
        <<switch $_holdemState.phase>>
          <<case 'ready'>><<lanSwitch 'Waiting for a hand' '等待发牌'>>
          <<case 'preflop'>><<lanSwitch 'Pre-flop' '翻牌前'>>
          <<case 'flop'>><<lanSwitch 'Flop' '翻牌圈'>>
          <<case 'turn'>><<lanSwitch 'Turn' '转牌圈'>>
          <<case 'river'>><<lanSwitch 'River' '河牌圈'>>
          <<case 'done'>><<lanSwitch 'Hand settled' '本局已结算'>>
        <</switch>>
        · <<lanSwitch 'Pot' '底池'>> <<printmoney $_holdem.pot>> · <<lanSwitch 'Blinds' '盲注'>> <<printmoney `$_holdem.bigBlind / 2`>> / <<printmoney $_holdem.bigBlind>>
      </p>
      <section class='poker-board'>
        <p class='gold'><<lanSwitch 'Community cards' '公共牌'>></p>
        <div class='poker-cards' data-cards='board' data-visible='true' data-placeholders='5'></div>
      </section>
      <<for $_holdemIndex, $_holdemSeat range $_holdemState.seats>>
        <<set $_holdemVisible to (!$_holdemWatching and $_holdemIndex is 0) or ($_holdemState.phase is 'done' and $_holdemState.showdown and !$_holdemSeat.folded)>>
        <section @class="'poker-seat' + ($_holdemSeat.folded ? ' poker-folded' : '')">
          <strong><<deadwood-poker-name `$_holdemSeat.name`>>
          <<if $_holdemIndex is $_holdemState.button>>
            <<lanSwitch ' · Button' ' · 庄位'>>
          <</if>>
          </strong>
          <p class='poker-seat-detail'>
            <<lanSwitch `$_holdemPub ? 'Cash' : 'Chips'` `$_holdemPub ? '现金' : '筹码'`>> <<printmoney $_holdemSeat.stack>> · <<lanSwitch 'This round' '本轮投入'>> <<printmoney $_holdemSeat.street_bet>>
            <<if $_holdemSeat.folded>><<lanSwitch ' · Folded' ' · 已弃牌'>>
            <<elseif $_holdemSeat.stack is 0 and $_holdem.active>><<lanSwitch ' · All-in' ' · 已全下'>><</if>>
          </p>
          <div class='poker-cards' @data-cards="$_holdemIndex" @data-visible="$_holdemVisible" @data-peek="!$_holdemWatching and $_holdemState.trick.peeked is $_holdemIndex" data-placeholders='2'></div>
          <<if $_holdemVisible and $_holdemSeat.cards.length and $_holdemState.board.length gte 3>>
            <p class='poker-hand-name'><<lanSwitch `$_holdemHandNames[$_holdem.handRank($_holdemIndex)][0]` `$_holdemHandNames[$_holdem.handRank($_holdemIndex)][1]`>></p>
          <</if>>
        </section>
      <</for>>
    <</if>>
  </div>
  <<if $_holdemState.joined>>
    <<deadwood-poker-log `$_holdemPub ? 'pub' : $_holdemPrivate ? 'private' : $_holdemWatching ? 'watch' : 'holdem'`>>
  <</if>>
  <div class='poker-controls'>
    <<if $_holdemWatching>>
      <<if $_holdem.active>>
        <button type='button' data-action='next' @data-disabled="!$_holdem.available"><<lanSwitch 'Continue watching' '继续旁观'>><<if $_holdemPrivate>> (0:01)<</if>></button>
      <<elseif $_holdemPrivate and $_holdem.canDeal>>
        <button type='button' data-action='deal' @data-disabled="!$_holdem.canDeal"><<lanSwitch 'Deal another hand (0:02)' '再发一局 (0:02)'>></button>
      <</if>>
    <<elseif !$_holdemState.joined>>
      <<for $_holdemBuyIn range $_holdem.buyIns>>
        <button type='button' data-action='join' @data-amount="$_holdemBuyIn" @data-disabled="!$_holdem.available || $_holdem.funds < $_holdemBuyIn"><<lanSwitch 'Bring to the table: ' '带上牌桌：'>><<printmoney $_holdemBuyIn>><<if !$_holdemPrivate and !$_holdemPub>><<lanSwitch ' chips' ' 筹码'>><</if>></button>
      <</for>>
    <<else>>
      <<if $_holdem.active>>
        <button type='button' data-action='fold' @data-disabled="!$_holdem.canAct"><<lanSwitch 'Fold (0:01)' '弃牌 (0:01)'>></button>
        <button type='button' @data-action="$_holdem.callAmount ? 'call' : 'check'" @data-disabled="!$_holdem.canAct">
          <<if $_holdem.callAmount>><<lanSwitch 'Call ' '跟注 '>><<printmoney $_holdem.callAmount>> (0:01)
          <<else>><<lanSwitch 'Check (0:01)' '过牌 (0:01)'>><</if>>
        </button>
        <label class='poker-raise'><<lanSwitch 'Raise this round to £' '本轮加注至 £'>>
          <input type='number' @min="$_holdem.minimumRaise / 100" @max="$_holdem.maximumRaise / 100" step='0.01' @value="$_holdem.minimumRaise / 100" @data-disabled="!$_holdem.canRaise || $_holdem.maximumRaise < $_holdem.minimumRaise">
        </label>
        <button type='button' data-action='raise' @data-disabled="!$_holdem.canRaise || $_holdem.maximumRaise < $_holdem.minimumRaise"><<lanSwitch 'Raise (0:01)' '加注 (0:01)'>></button>
        <button type='button' data-action='allin' @data-disabled="!$_holdem.canAct || ($_holdem.maximumRaise > $_holdemState.current_bet && !$_holdem.canRaise)"><<lanSwitch 'All-in ' '全下 '>><<printmoney $_holdem.player.stack>> (0:01)</button>
      <<elseif !$_holdemPrivate or $_holdem.canDeal>><button type='button' data-action='deal' @data-disabled="!$_holdem.canDeal"><<lanSwitch 'Deal a hand (0:02)' '发牌 (0:02)'>></button><</if>>
      <<if !$_holdemPrivate>><button type='button' data-action='cashout'>
        <<if $_holdemPub>><<lanSwitch `$_holdem.active ? 'Fold and collect remaining cash' : 'Collect remaining cash'` `$_holdem.active ? '弃牌并收回余款' : '收回余款'`>>
        <<else>><<lanSwitch `$_holdem.active ? 'Fold and return chips' : 'Return chips'` `$_holdem.active ? '弃牌并收回剩余筹码' : '收回筹码'`>><</if>>
      </button><</if>>
    <</if>>
  </div>
  <<if $_holdemState.phase is 'done'>>
    <<for $_holdemPotIndex, $_holdemPot range $_holdemState.pots>>
      <p @class="$_holdemWatching or $_holdemPot.winners.includes(0) ? 'gold' : 'blue'">
        <<lanSwitch `$_holdemPot.returned ? ($_holdemPub ? 'Uncalled cash returned' : 'Uncalled chips returned') : $_holdemPotIndex === 0 ? 'Main pot' : 'Side pot'` `$_holdemPot.returned ? ($_holdemPub ? '未被跟注的钱退回' : '未被跟注的筹码退回') : $_holdemPotIndex === 0 ? '主池' : '边池'`>> <<printmoney `$_holdemPot.amount - $_holdemPot.fee`>> →
        <<for $_holdemWinnerIndex, $_holdemWinner range $_holdemPot.winners>>
        <<if $_holdemWinnerIndex gt 0>>
          /
        <</if>>
        <<deadwood-poker-name `$_holdemState.seats[$_holdemWinner].name`>><</for>>
      </p>
    <</for>>
    <<if !$_holdemPrivate and !$_holdemPub>><p class='poker-fee'><<lanSwitch 'Table fee' '本局抽水'>> <<printmoney $_holdemState.fee>></p><</if>>
  <</if>>
<</widget>>

<<widget 'deadwood-poker-three-view'>>
  <<set $_threeHandNames to [['High card', '单张'], ['Pair', '对子'], ['Straight', '顺子'], ['Flush', '金花'], ['Straight flush', '顺金'], ['Three of a kind', '豹子']]>>
  <<set $_three to maplebirch.get('LifeSimulation').casino.threeCard>><<set $_threeState to $_three.state>>
  <p><<lanSwitch 'Seats: ' '本桌人数：'>><<= $_three.tableSize>></p>
  <div class='poker-table'>
    <p class='poker-summary'><<lanSwitch 'Ante' '底注'>> <<printmoney $_threeState.ante>> · <<lanSwitch 'Pot' '底池'>> <<printmoney $_three.pot>> · <<lanSwitch 'Rounds' '下注轮数'>> <<print $_threeState.rounds>>/10</p>
    <<if $_threeState.seats.length>>
      <<for $_threeIndex, $_threeSeat range $_threeState.seats>>
        <<set $_threeVisible to $_threeIndex is 0 ? ($_threeSeat.seen or $_threeState.compared.length gt 0) : $_threeState.trick.peeked is $_threeIndex or $_threeState.compared.includes($_threeIndex) or ($_threeState.phase is 'done' and $_threeState.showdown and !$_threeSeat.folded)>>
        <section @class="'poker-seat' + ($_threeSeat.folded ? ' poker-folded' : '')">
          <strong><<deadwood-poker-name `$_threeSeat.name`>></strong>
          <p class='poker-seat-detail'><<lanSwitch 'Committed' '累计投入'>> <<printmoney $_threeSeat.total>> ·
            <<if $_threeSeat.folded>><<lanSwitch 'Folded' '已弃牌'>>
            <<elseif $_threeSeat.seen>><<lanSwitch 'Seen' '已看牌'>>
            <<else>><<lanSwitch 'Blind' '暗牌'>><</if>>
          </p>
          <div class='poker-cards' @data-cards="$_threeIndex" @data-visible="$_threeVisible"></div>
          <<if $_threeVisible>>
            <p class='poker-hand-name'><<lanSwitch `$_threeHandNames[$_three.handRank($_threeIndex)][0]` `$_threeHandNames[$_three.handRank($_threeIndex)][1]`>></p>
          <</if>>
        </section>
      <</for>>
    <<else>><div class='poker-cards' data-cards='0' data-visible='false' data-placeholders='3'></div><</if>>
  </div>
  <<deadwood-poker-log 'three'>>
  <div class='poker-controls'>
    <<if $_threeState.phase is 'player'>>
      <button type='button' data-action='look' @data-disabled="!$_three.canAct || $_threeState.seats[0].seen"><<lanSwitch 'Look at your cards' '看牌'>></button>
      <button type='button' data-action='call' @data-disabled="!$_three.canAct || $_three.funds < $_three.callCost"><<lanSwitch 'Call ' '跟注 '>><<printmoney $_three.callCost>> (0:01)</button>
      <button type='button' data-action='raise' @data-disabled="!$_three.canRaise"><<lanSwitch 'Raise ' '加注 '>><<printmoney `$_three.callCost * 2`>> (0:01)</button>
      <<if $_threeState.seats[0].seen>>
        <<for $_threeTarget, $_threeOpponent range $_threeState.seats>>
          <<if $_threeTarget gt 0 and !$_threeOpponent.folded>>
            <button type='button' data-action='compare' @data-amount="$_threeTarget" @data-disabled="!$_three.canAct || $_three.funds < $_three.compareCost">
              <<lanSwitch 'Compare with ' '与'>><<deadwood-poker-name `$_threeState.seats[$_threeTarget].name`>><<lanSwitch ' (' '比牌 ('>><<printmoney $_three.compareCost>> 0:01)
            </button>
          <</if>>
        <</for>>
      <</if>>
      <button type='button' data-action='fold' @data-disabled="!$_three.canAct"><<lanSwitch 'Fold (0:01)' '弃牌 (0:01)'>></button>
    <<else>>
      <<for $_threeSize range $_three.options.seats>>
        <button type='button' data-action='seats' @data-amount="$_threeSize" @aria-pressed="String($_threeSize === $_three.tableSize)"><<= $_threeSize>><<lanSwitch ' seats' ' 人桌'>></button>
      <</for>>
      <<for $_threeAnte range $_three.antes>>
        <button type='button' data-action='ante' @data-amount="$_threeAnte" @aria-pressed="String($_threeAnte === $_threeState.ante)"><<lanSwitch 'Ante ' '底注 '>><<printmoney $_threeAnte>></button>
      <</for>>
      <button type='button' data-action='start' @data-disabled="!$_three.canStart"><<lanSwitch 'Deal (' '发牌 ('>><<printmoney $_threeState.ante>> 0:02)</button>
    <</if>>
  </div>
  <<if $_threeState.phase is 'done'>>
    <p @class="$_threeState.winners.includes(0) ? 'gold' : 'red'">
      <<if $_threeState.winners.includes(0)>><<lanSwitch 'You win ' '你赢得 '>><<printmoney $_threeState.payout>><<lanSwitch ' after the table fee.' '，已扣除抽水。'>>
      <<else>><<lanSwitch 'Hand won by ' '本局赢家：'>><<for $_threeWinnerIndex, $_threeWinner range $_threeState.winners>><<if $_threeWinnerIndex gt 0>> / <</if>><<deadwood-poker-name `$_threeState.seats[$_threeWinner].name`>><</for>>.<</if>>
    </p>
  <</if>>
<</widget>>
